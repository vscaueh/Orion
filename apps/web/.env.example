# Copie para .env.local e preencha. Nunca commite o .env.local.

# Projeto Supabase (dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica

# Único e-mail autorizado a entrar no Orion. Qualquer outro login
# Google é barrado pelo middleware. Server-only (sem NEXT_PUBLIC_).
OWNER_EMAIL=voce@exemplo.com

# Como a Orion e o site chamam você nas saudações. Opcional.
OWNER_NAME=Motta

# Modelo da Orion. A chave nunca vai ao cliente — só o servidor a lê.
# Gere em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave
# Opcional: trocar o modelo sem mexer no código. O Google aposenta
# modelos para contas novas; quando isso acontecer, o erro da API diz
# qual é o substituto e é só trocar aqui.
GEMINI_MODEL=gemini-3.6-flash
