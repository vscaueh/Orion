# Copie para .env.local e preencha. Nunca commite o .env.local.

# Projeto Supabase (dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica

# Único e-mail autorizado a entrar no Orion. Qualquer outro login
# Google é barrado pelo middleware. Server-only (sem NEXT_PUBLIC_).
OWNER_EMAIL=voce@exemplo.com

# Como a Orion e o site chamam você nas saudações. Opcional.
OWNER_NAME=Motta
