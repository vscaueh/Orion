# Copie para .env e preencha. Nunca commite o .env.

# Supabase — a chave SECRETA, que ignora RLS. Só o worker a usa; ela
# nunca existe no apps/web.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# O id do seu usuário no Supabase (Authentication → Users → sua linha).
OWNER_USER_ID=00000000-0000-0000-0000-000000000000

GEMINI_API_KEY=sua-chave
GEMINI_MODEL=gemini-3.6-flash

# Telegram: crie o bot com o @BotFather. O chat id sai de
# https://api.telegram.org/bot<TOKEN>/getUpdates depois de mandar uma
# mensagem qualquer para ele.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
